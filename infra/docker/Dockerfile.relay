FROM rust:1.83-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY server/relay/Cargo.toml server/relay/Cargo.toml
RUN mkdir -p server/relay/src && echo "fn main(){}" > server/relay/src/main.rs
RUN cargo build --release -p veil-relay 2>/dev/null || true
COPY . .
RUN cargo build --release -p veil-relay

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/veil-relay /usr/local/bin/veil-relay
ENV VEIL_RELAY_PORT=8080
EXPOSE 8080
CMD ["veil-relay"]
