# Veil Messenger — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env with real secrets.

# Relay server
VEIL_RELAY_PORT=8080
VEIL_RELAY_BASE_URL=http://localhost:8080

# Redis (Phase 5 — optional for local dev, uses in-memory if unset)
# VEIL_REDIS_URL=redis://localhost:6379

# Client defaults
VEIL_USE_MOCK_SERVICES=true

# Push (Phase 5 — not wired yet)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.veil.messenger
# APNS_KEY_PATH=./secrets/AuthKey.p8
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json

# TURN (Phase 6 — not wired yet)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Logging
RUST_LOG=veil_relay=debug,tower_http=debug
